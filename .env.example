# Port on your host machine where the app will be accessible
HOST_PORT=8080

# Port internal to the container (Default is 3000)
CONTAINER_PORT=3000

# Set to true when running behind a trusted reverse proxy (e.g. Coolify, Caddy, Nginx)
TRUST_PROXY=false

# Optional secret key for signing anti-bot CAPTCHA tokens (auto-generated if left blank)
CAPTCHA_SECRET=
